# Copia este archivo a .env y rellena los valores. .env no se sube a Git.
DEBUG=True
SECRET_KEY=cambia-esta-clave
DATABASE_URL=postgres://usuario:password@localhost:5432/recetario
CORS_ALLOWED_ORIGINS=http://localhost:5173
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Opcional: URL base de otra API compatible con OpenAI (vacío = api.openai.com)
AI_BASE_URL=
# Opcional: modelos de reserva (separados por comas) si el principal está saturado
AI_FALLBACK_MODELS=
# Opcional: clave gratuita de Pexels (https://www.pexels.com/api/) para fotos de muestra de más platos
PEXELS_API_KEY=
# Traducción al español de las recetas (TheMealDB está en inglés).
# auto = IA si hay AI_API_KEY, si no MyMemory (gratis, sin clave). Otros: mymemory, ai, none
TRANSLATION_PROVIDER=auto
# Opcional: tu correo sube el cupo diario gratuito de MyMemory de 5.000 a 50.000 caracteres
MYMEMORY_EMAIL=
